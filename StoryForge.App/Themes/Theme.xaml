<!--
  The dark theme from the design canvas (claude.ai artifact PjhEHQtoisZtPRSuQKLsFV): IBM Plex Sans
  for text, IBM Plex Mono for technical values, amber as the one accent.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="SansFont">pack://application:,,,/Assets/Fonts/#IBM Plex Sans</FontFamily>
  <FontFamily x:Key="MonoFont">pack://application:,,,/Assets/Fonts/#IBM Plex Mono</FontFamily>

  <SolidColorBrush x:Key="GroundBrush" Color="#141518" />
  <SolidColorBrush x:Key="TopBarBrush" Color="#0F1012" />
  <SolidColorBrush x:Key="NavBrush" Color="#17181C" />
  <SolidColorBrush x:Key="NavHoverBrush" Color="#1F2126" />
  <SolidColorBrush x:Key="CardBrush" Color="#1C1E22" />
  <SolidColorBrush x:Key="FieldBrush" Color="#23262B" />
  <SolidColorBrush x:Key="BorderBrush" Color="#2A2D33" />

  <SolidColorBrush x:Key="TextBrush" Color="#ECEBE7" />
  <SolidColorBrush x:Key="TextSoftBrush" Color="#C9CBD0" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="#8C9098" />
  <SolidColorBrush x:Key="TextDimBrush" Color="#7D818A" />

  <SolidColorBrush x:Key="AccentBrush" Color="#E3A43B" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#F0BD66" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#2A2418" />

  <!-- Status pill colours, one pair per provider state. -->
  <SolidColorBrush x:Key="PillNeutralBackBrush" Color="#23262B" />
  <SolidColorBrush x:Key="PillNeutralTextBrush" Color="#A3A6AD" />

  <!-- A 24×24 stroke icon from path data, drawn at 18×18 in the current foreground colour. -->
  <DataTemplate x:Key="StrokeIconTemplate">
    <Viewbox Width="18" Height="18">
      <Canvas Width="24" Height="24">
        <Path Data="{Binding}"
              Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"
              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Canvas>
    </Viewbox>
  </DataTemplate>

  <!-- Keyboard focus ring for rounded items; WPF shows it only when navigating by keyboard. -->
  <Style x:Key="RoundedFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource AccentBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Navigation item: amber when selected, a lighter ground on hover. -->
  <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Padding="12,10">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoftBrush}" />
              <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Status pill in the top bar: "● ComfyUI · not set up". -->
  <DataTemplate x:Key="ProviderPillTemplate">
    <Border CornerRadius="999" Padding="10,4" Margin="8,0,0,0" Background="{StaticResource PillNeutralBackBrush}">
      <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource PillNeutralTextBrush}">
        <Run Text="●" /> <Run Text="{Binding Text, Mode=OneWay}" />
      </TextBlock>
    </Border>
  </DataTemplate>

  <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
  </Style>

</ResourceDictionary>
