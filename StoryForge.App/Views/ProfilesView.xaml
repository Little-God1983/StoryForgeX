<UserControl x:Class="StoryForge.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="clr-namespace:StoryForge.App.ViewModels.Pages"
             xmlns:profiles="clr-namespace:StoryForge.App.ViewModels.Profiles"
             xmlns:views="clr-namespace:StoryForge.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=pages:ProfilesPageViewModel}">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <CollectionViewSource x:Key="GroupedProfiles" Source="{Binding Profiles}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="GroupTitle" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>

    <Style x:Key="ProfileItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource NavItemStyle}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- A multi-line field: instructions in the sans face, templates in mono. -->
    <Style x:Key="AreaStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="ErrorBannerStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PillErrorBackBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="FieldBlockStyle" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <!-- One profile: the fields on the left, workflow inputs, references and Save on the right. -->
    <DataTemplate DataType="{x:Type profiles:ProfileEditorViewModel}">
      <Grid Margin="32,28,32,24">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16">
          <Border DockPanel.Dock="Right" Background="{StaticResource FieldBrush}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
            <TextBlock Text="{Binding StateText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource TextSoftBrush}"
                       AutomationProperties.AutomationId="ProfileState" />
          </Border>
          <ComboBox DockPanel.Dock="Right" Width="96" Margin="0,0,10,0" VerticalAlignment="Center"
                    ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" ItemStringFormat="v{0}"
                    AutomationProperties.Name="Version">
            <!-- Screen readers announce "v2", not the bare number. -->
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                <Setter Property="AutomationProperties.Name" Value="{Binding StringFormat='v{0}'}" />
              </Style>
            </ComboBox.ItemContainerStyle>
          </ComboBox>
          <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Left: the profile's fields. -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel>
            <Border Style="{StaticResource ErrorBannerStyle}">
              <Border.Visibility>
                <Binding Path="Error">
                  <Binding.Converter>
                    <views:NullToCollapsedConverter />
                  </Binding.Converter>
                </Binding>
              </Border.Visibility>
              <TextBlock Text="{Binding Error}" Foreground="{StaticResource PillErrorTextBrush}" FontSize="13" TextWrapping="Wrap" />
            </Border>

            <Border Background="{StaticResource NoteBackBrush}" BorderBrush="{StaticResource NoteBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding IsViewingOlderVersion, Converter={StaticResource Visible}}">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Back to latest" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding ShowLatestCommand}" />
                <Button DockPanel.Dock="Right" Content="Restore into draft" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding RestoreShownVersionCommand}" />
                <TextBlock Foreground="{StaticResource NoteTextBrush}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center">
                  <Run Text="An older version, as it was saved. It cannot be changed; restore it into the draft to build on it." />
                </TextBlock>
              </DockPanel>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,-12,0">
              <StackPanel Style="{StaticResource FieldBlockStyle}" Margin="0,0,12,16">
                <TextBlock Text="Stage" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding KindLabel, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource SansFont}"
                         Foreground="{StaticResource TextSoftBrush}" AutomationProperties.Name="Stage" />
              </StackPanel>
              <StackPanel Style="{StaticResource FieldBlockStyle}" Margin="0,0,12,16">
                <TextBlock Text="Provider" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Shown.ProviderChoices}" SelectedItem="{Binding Shown.Provider}"
                          IsEnabled="{Binding Shown.IsEditable}" AutomationProperties.Name="Provider" />
              </StackPanel>
              <StackPanel Style="{StaticResource FieldBlockStyle}" Margin="0,0,12,16"
                          Visibility="{Binding Shown.IsMedia, Converter={StaticResource Visible}}">
                <TextBlock Text="Workflow template" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{Binding Shown.TemplateChoices}" SelectedItem="{Binding Shown.WorkflowTemplate}"
                          IsEnabled="{Binding Shown.IsEditable}" AutomationProperties.Name="Workflow template" />
              </StackPanel>
            </UniformGrid>
            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,-8,0,16"
                       Text="No workflow files found. Export your ComfyUI workflows in API format into the templates folder set under Settings → Providers → ComfyUI.">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Shown.IsMedia}" Value="True" />
                        <Condition Binding="{Binding Shown.HasTemplates}" Value="False" />
                      </MultiDataTrigger.Conditions>
                      <Setter Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <StackPanel Style="{StaticResource FieldBlockStyle}">
              <TextBlock Text="{Binding Shown.InstructionsLabel}" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding Shown.Instructions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AreaStyle}"
                       FontFamily="{StaticResource SansFont}" FontSize="14" Height="150" IsReadOnly="{Binding Shown.IsReadOnly}"
                       AutomationProperties.Name="Instructions" />
            </StackPanel>

            <StackPanel Style="{StaticResource FieldBlockStyle}" Visibility="{Binding Shown.IsResearch, Converter={StaticResource Visible}}">
              <TextBlock Text="Default research sources, one per line" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding Shown.ResearchSources, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AreaStyle}"
                       Height="150" IsReadOnly="{Binding Shown.IsReadOnly}" AutomationProperties.Name="Research sources" />
            </StackPanel>

            <StackPanel Style="{StaticResource FieldBlockStyle}" Visibility="{Binding Shown.IsMedia, Converter={StaticResource Visible}}">
              <TextBlock Text="Prompt template" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding Shown.PromptTemplate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AreaStyle}"
                       Height="76" IsReadOnly="{Binding Shown.IsReadOnly}" AutomationProperties.Name="Prompt template" />
            </StackPanel>

            <StackPanel Style="{StaticResource FieldBlockStyle}" Visibility="{Binding Shown.HasNegativePrompt, Converter={StaticResource Visible}}">
              <TextBlock Text="Negative prompt" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding Shown.NegativePrompt, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource CardBrush}"
                       IsReadOnly="{Binding Shown.IsReadOnly}" AutomationProperties.Name="Negative prompt" />
            </StackPanel>

            <StackPanel Style="{StaticResource FieldBlockStyle}" Visibility="{Binding Shown.IsVoice, Converter={StaticResource Visible}}">
              <TextBlock Text="Voice" Style="{StaticResource FieldLabelStyle}" />
              <TextBox Text="{Binding Shown.Voice, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource CardBrush}"
                       IsReadOnly="{Binding Shown.IsReadOnly}" AutomationProperties.Name="Voice" />
            </StackPanel>

            <UniformGrid Columns="3" Margin="0,0,-12,0" HorizontalAlignment="Stretch">
              <StackPanel Style="{StaticResource FieldBlockStyle}" Margin="0,0,12,16" Visibility="{Binding Shown.HasSteps, Converter={StaticResource Visible}}">
                <TextBlock Text="Steps (empty: the workflow's own)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Shown.Steps, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         IsReadOnly="{Binding Shown.IsReadOnly}" AutomationProperties.Name="Steps" />
              </StackPanel>
              <StackPanel Style="{StaticResource FieldBlockStyle}" Margin="0,0,12,16" Visibility="{Binding Shown.IsVideo, Converter={StaticResource Visible}}">
                <TextBlock Text="Max clip length (s)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Shown.MaxClipSeconds, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         IsReadOnly="{Binding Shown.IsReadOnly}" AutomationProperties.Name="Max clip length in seconds" />
              </StackPanel>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>

        <!-- Right: what goes into the workflow, the references, and Save. -->
        <DockPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
          <StackPanel DockPanel.Dock="Bottom">
            <Border Background="{StaticResource NoteBackBrush}" BorderBrush="{StaticResource NoteBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="16,14" Margin="0,0,0,14">
              <TextBlock Text="{Binding SaveNote}" Foreground="{StaticResource NoteTextBrush}" FontSize="13" TextWrapping="Wrap" />
            </Border>
            <Button Content="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" />
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,0,14">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}" Visibility="{Binding Shown.IsMedia, Converter={StaticResource Visible}}">
                <StackPanel>
                  <TextBlock Text="Workflow inputs" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Text="Which profile value goes into which node of the workflow, e.g. #6.text."
                             FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10" />
                  <ItemsControl ItemsSource="{Binding Shown.Inputs}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type profiles:WorkflowInputRowViewModel}">
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Key, StringFormat='{}{0} →'}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center" />
                          <TextBox Grid.Column="1" Text="{Binding Node, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,5"
                                   IsReadOnly="{Binding IsReadOnly}" AutomationProperties.Name="{Binding Key, StringFormat='Workflow node for {0}'}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Shown.Sizes}" Focusable="False" Margin="0,6,0,0"
                                Visibility="{Binding Shown.HasSizes, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type profiles:SizeRowViewModel}">
                        <Grid Margin="0,0,0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Aspect, StringFormat='size {0}'}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center" />
                          <TextBox Grid.Column="1" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,5"
                                   IsReadOnly="{Binding IsReadOnly}" AutomationProperties.Name="{Binding Aspect, StringFormat='Width for {0}'}" />
                          <TextBlock Grid.Column="2" Text="×" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                          <TextBox Grid.Column="3" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="8,5"
                                   IsReadOnly="{Binding IsReadOnly}" AutomationProperties.Name="{Binding Aspect, StringFormat='Height for {0}'}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardStyle}" Visibility="{Binding Shown.IsMedia, Converter={StaticResource Visible}}">
                <StackPanel>
                  <TextBlock Text="{Binding Shown.ReferenceFilesTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
                  <ItemsControl ItemsSource="{Binding Shown.ReferenceFiles}" Focusable="False"
                                AutomationProperties.Name="{Binding Shown.ReferenceFilesTitle}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="94" Margin="0,0,8,8" ToolTip="{Binding}">
                          <Border CornerRadius="8" Background="{StaticResource FieldBrush}" ClipToBounds="True">
                            <Grid>
                              <TextBlock Text="{Binding Converter={views:FileNameConverter}}" FontSize="11" TextWrapping="Wrap"
                                         Foreground="{StaticResource TextMutedBrush}" Margin="6" VerticalAlignment="Bottom" />
                              <Image Source="{Binding Converter={views:ThumbnailConverter}}" Stretch="UniformToFill" />
                            </Grid>
                          </Border>
                          <Button Content="×" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Command="{Binding DataContext.RemoveReferenceFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}"
                                  Visibility="{Binding DataContext.Shown.IsEditable, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Visible}}"
                                  AutomationProperties.Name="{Binding Converter={views:FileNameConverter}, StringFormat='Remove {0}'}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="+ Add…" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="AddReferenceFiles_Click"
                          Visibility="{Binding Shown.IsEditable, Converter={StaticResource Visible}}"
                          AutomationProperties.Name="{Binding Shown.ReferenceFilesTitle, StringFormat='Add {0}'}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- The profile list, grouped by kind, with "+ New profile" on top. -->
    <Border Grid.Column="0" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,20">
      <DockPanel>
        <Button DockPanel.Dock="Top" Content="+ New profile" Style="{StaticResource SecondaryButtonStyle}" Height="40" Margin="0,0,0,12"
                Command="{Binding StartCreateCommand}" Click="NewProfile_Click" />

        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Visibility="{Binding IsCreating, Converter={StaticResource Visible}}">
          <StackPanel>
            <TextBlock Text="Stage" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding KindChoices}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding NewKind}"
                      Margin="0,0,0,12" AutomationProperties.Name="New profile stage" />
            <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="NewNameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource SansFont}"
                     AutomationProperties.Name="New profile name">
              <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding CreateCommand}" />
                <KeyBinding Key="Escape" Command="{Binding CancelCreateCommand}" />
              </TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="{Binding CreateError}" Foreground="{StaticResource ErrorTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0">
              <TextBlock.Visibility>
                <Binding Path="CreateError">
                  <Binding.Converter>
                    <views:NullToCollapsedConverter />
                  </Binding.Converter>
                </Binding>
              </TextBlock.Visibility>
            </TextBlock>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
              <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCreateCommand}" Margin="0,0,8,0" />
              <Button Content="Create" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CreateCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="No profiles yet. Each stage of a project uses one; start with + New profile."
                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="12,4">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasProfiles}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <ListBox ItemsSource="{Binding Source={StaticResource GroupedProfiles}}" SelectedItem="{Binding SelectedProfile}"
                 SelectionChanged="Profiles_SelectionChanged"
                 ItemContainerStyle="{StaticResource ProfileItemStyle}" Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Profiles">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabelStyle}" Margin="12,10,0,4" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type profiles:ProfileListItemViewModel}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="●" Foreground="{StaticResource AccentBrush}" FontSize="10" VerticalAlignment="Center"
                           Margin="8,0,0,0" ToolTip="Unsaved changes"
                           Visibility="{Binding HasUnsavedChanges, Converter={StaticResource Visible}}" />
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- The selected profile, or why there is none. -->
    <Grid Grid.Column="1">
      <StackPanel Margin="32,28">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Style.Triggers>
              <DataTrigger Binding="{Binding Editor}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
            <Setter Property="Visibility" Value="Collapsed" />
          </Style>
        </StackPanel.Style>
        <TextBlock Text="Profiles" FontSize="26" FontWeight="Bold" />
        <TextBlock Text="A profile is a saved recipe for one stage and one model. Pick one on the left, or start one with + New profile."
                   TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,16" MaxWidth="640" HorizontalAlignment="Left" />
        <Border Style="{StaticResource ErrorBannerStyle}" HorizontalAlignment="Left" MaxWidth="640">
          <Border.Visibility>
            <Binding Path="LoadError">
              <Binding.Converter>
                <views:NullToCollapsedConverter />
              </Binding.Converter>
            </Binding>
          </Border.Visibility>
          <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource PillErrorTextBrush}" FontSize="13" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
      <ContentControl Content="{Binding Editor}" Focusable="False" />
    </Grid>
  </Grid>
</UserControl>
