<UserControl x:Class="StoryForge.App.Views.ReferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:refs="clr-namespace:StoryForge.App.ViewModels.References"
             xmlns:script="clr-namespace:StoryForge.App.ViewModels.Script"
             xmlns:views="clr-namespace:StoryForge.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=refs:ReferencesViewModel}">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style x:Key="BarStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="PanelBoxStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- A reference's card: its first image, name and state, how often it is shown, what it is made from. -->
    <DataTemplate x:Key="CardTemplate" DataType="{x:Type refs:ReferenceCardViewModel}">
      <Button Command="{Binding SelectCommand}" Width="210" Margin="0,0,10,10" Cursor="Hand" AutomationProperties.Name="{Binding AccessibleName}"
              FocusVisualStyle="{StaticResource RoundedFocusVisual}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource TextBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsMissing}" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource PillErrorBackBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsStale}" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource NoteBackBrush}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
        <StackPanel>
          <Border Height="120" CornerRadius="6" Background="#23262B" Margin="0,0,0,8" ClipToBounds="True">
            <Grid>
              <TextBlock Text="{Binding StateText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Image Source="{Binding Thumbnail, Converter={views:ThumbnailConverter}, ConverterParameter=400}" Stretch="UniformToFill" />
            </Grid>
          </Border>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" FontSize="12">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource PillOffTextBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding StateText}" Value="approved">
                      <Setter Property="Foreground" Value="{StaticResource PillOkTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource PillErrorTextBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsStale}" Value="True">
                      <Setter Property="Foreground" Value="#B4A8F5" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
          </DockPanel>
          <TextBlock Text="{Binding Usage}" FontSize="12" Foreground="{StaticResource TextSoftBrush}" Margin="0,2,0,0" />
          <TextBlock Text="{Binding SourcesText}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
          <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                     Visibility="{Binding Note, Converter={views:NullToCollapsedConverter}}" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="WrapItems">
      <WrapPanel />
    </ItemsPanelTemplate>

    <!-- The timeline's columns: each as wide as its shot lasts. -->
    <ItemsPanelTemplate x:Key="ShotColumns">
      <views:WeightedPanel />
    </ItemsPanelTemplate>

    <Style x:Key="ShotColumnStyle" TargetType="ContentPresenter">
      <Setter Property="views:WeightedPanel.Weight" Value="{Binding Seconds}" />
    </Style>

    <!-- A plain button: only what it holds shows. -->
    <ControlTemplate x:Key="BareButton" TargetType="Button">
      <Border Background="Transparent">
        <ContentPresenter VerticalAlignment="Center" />
      </Border>
    </ControlTemplate>

    <!-- One reference in one shot: a bar in its kind's colour when it is in it. -->
    <DataTemplate x:Key="TimelineCellTemplate" DataType="{x:Type refs:TimelineCellViewModel}">
      <!-- A full shot's button is disabled and gets no mouse input: the cursor that says so sits around it. -->
      <Border x:Name="Slot" Background="Transparent">
      <Button Command="{Binding DataContext.ToggleCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
              Height="26" Cursor="Hand" AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding AccessibleName}"
              ToolTipService.ShowOnDisabled="True" FocusVisualStyle="{StaticResource RoundedFocusVisual}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Cell" Background="Transparent" BorderBrush="#23262B" BorderThickness="1,0,0,0" Padding="2,5">
              <Border x:Name="Bar" CornerRadius="4" Background="#6FB3EE" Visibility="Collapsed" />
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding DataContext.Kind, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Place">
                <Setter TargetName="Bar" Property="Background" Value="#7FD1C2" />
              </DataTrigger>
              <DataTrigger Binding="{Binding DataContext.Kind, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="Object">
                <Setter TargetName="Bar" Property="Background" Value="#B4A8F5" />
              </DataTrigger>
              <DataTrigger Binding="{Binding DataContext.IsSelected, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding DataContext.IsDimmed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                <Setter TargetName="Bar" Property="Opacity" Value="0.5" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsOn}" Value="True">
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Cell" Property="Background" Value="#2A2D33" />
              </Trigger>
              <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                <Setter TargetName="Cell" Property="Background" Value="#1F1A1A" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
          <Setter TargetName="Slot" Property="Cursor" Value="No" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <!-- Where the references stand. -->
    <StackPanel DockPanel.Dock="Top">
      <Border Style="{StaticResource BarStyle}" Background="#172536" BorderBrush="#2B4A6B" Visibility="{Binding IsMaking, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" AutomationProperties.Name="Cancel the references" />
          <TextBlock Text="Making the references" FontSize="14" FontWeight="SemiBold" Foreground="#6FB3EE" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock Text="{Binding Progress}" VerticalAlignment="Center" FontSize="13" Foreground="#BCD3EA" TextTrimming="CharacterEllipsis"
                     FontFamily="{StaticResource MonoFont}" AutomationProperties.AutomationId="ReferencesProgress" />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" Visibility="{Binding CanPropose, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Propose the references" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13" Command="{Binding ProposeCommand}" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                     Text="Once the storyboard is approved, the references are proposed from it: who and what it shows often, and pictures of them from your sources." />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource AccentSoftBrush}" BorderBrush="#5A4520" Visibility="{Binding ShowsListBar, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Make the images" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13" Command="{Binding MakeImagesCommand}" />
          <TextBlock Text="{Binding ListBarTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#D9C9A8" TextWrapping="Wrap"
                     Text="{Binding ListBarText}" />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource AccentSoftBrush}" BorderBrush="#5A4520" Visibility="{Binding ShowsGateBar, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Approve remaining" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Command="{Binding ApproveRemainingCommand}" AutomationProperties.Name="Approve remaining references" />
          <TextBlock Text="Gate: References" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#D9C9A8" TextWrapping="Wrap">
            <Run Text="{Binding ApprovedSummary, Mode=OneWay}" /> This stop is always on: Stills start when every reference is approved.
          </TextBlock>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillOkBackBrush}" BorderBrush="#2F5A50" Visibility="{Binding IsApproved, Converter={StaticResource Visible}}">
        <TextBlock FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap">
          <Run Text="References approved" FontWeight="SemiBold" Foreground="{StaticResource PillOkTextBrush}" />  Every image is approved. Stills arrive with #10.
        </TextBlock>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
              Visibility="{Binding ShowsTextOnlyBar, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Approve" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13" Command="{Binding ApproveTextOnlyCommand}"
                  AutomationProperties.Name="Approve without references" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                     Text="{Binding TextOnlyBarText}" />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillErrorBackBrush}" BorderBrush="#6B3A33" Visibility="{Binding IsFailed, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Background="{StaticResource ErrorTextBrush}" Command="{Binding RetryCommand}" AutomationProperties.Name="Retry the references" />
          <!-- #75: the newer version of the profile the stage started with. -->
          <Button DockPanel.Dock="Right" Content="{Binding NewerProfile}" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36" FontSize="13" Margin="0,0,8,0"
                  Command="{Binding UseNewerProfileCommand}" AutomationProperties.Name="{Binding NewerProfile}"
                  Visibility="{Binding NewerProfile, Converter={views:NullToCollapsedConverter}}" />
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="References failed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PillErrorTextBrush}" />
            <TextBlock Text="{Binding Error}" FontSize="13" Foreground="#E2C1BB" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.AutomationId="ReferencesError" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Background="{StaticResource PillErrorBackBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
              Visibility="{Binding ActionError, Converter={views:NullToCollapsedConverter}}">
        <TextBlock Text="{Binding ActionError}" Foreground="{StaticResource PillErrorTextBrush}" FontSize="13" TextWrapping="Wrap" />
      </Border>

      <!-- Adding to the list, and what it costs. -->
      <DockPanel Margin="0,0,0,12">
        <TextBlock DockPanel.Dock="Left" Text="{Binding CostText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                   VerticalAlignment="Center" Margin="0,0,16,0" AutomationProperties.AutomationId="ReferencesCost" />
        <Button DockPanel.Dock="Right" Content="+ Add" Style="{StaticResource SmallButtonStyle}" Command="{Binding AddReferenceCommand}" AutomationProperties.Name="Add to the list" />
        <ComboBox DockPanel.Dock="Right" ItemsSource="{x:Static refs:ReferencesViewModel.Kinds}" SelectedItem="{Binding NewKind}" Width="110" Margin="6,0"
                  AutomationProperties.Name="Kind of the new reference" />
        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Right" Width="240" Padding="8,4"
                 AutomationProperties.Name="Character, place or object to add" ToolTip="A character, place or object to add to the list" />
      </DockPanel>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="400" />
      </Grid.ColumnDefinitions>

      <!-- The cards, grouped by kind, and the rest of the cast. -->
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
        <StackPanel>
          <TextBlock Text="CHARACTERS" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" />
          <ItemsControl ItemsSource="{Binding Characters}" ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource WrapItems}" Focusable="False"
                        AutomationProperties.Name="Characters" />
          <TextBlock Text="PLACES" Style="{StaticResource SectionLabelStyle}" Margin="0,8,0,8" />
          <ItemsControl ItemsSource="{Binding Places}" ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource WrapItems}" Focusable="False"
                        AutomationProperties.Name="Places" />
          <TextBlock Text="OBJECTS" Style="{StaticResource SectionLabelStyle}" Margin="0,8,0,8" />
          <ItemsControl ItemsSource="{Binding Objects}" ItemTemplate="{StaticResource CardTemplate}" ItemsPanel="{StaticResource WrapItems}" Focusable="False"
                        AutomationProperties.Name="Objects" />

          <!-- The timeline: which reference goes into which shot. -->
          <Border Style="{StaticResource PanelBoxStyle}" Margin="0,8,10,12" Visibility="{Binding HasTimeline, Converter={StaticResource Visible}}">
            <StackPanel>
              <Button Command="{Binding ToggleTimelineCommand}" Template="{StaticResource BareButton}" Cursor="Hand" HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="Fold or open the timeline" FocusVisualStyle="{StaticResource RoundedFocusVisual}">
                <DockPanel>
                  <Path DockPanel.Dock="Left" Data="M 0 0 L 5 5 L 0 10" Stroke="{StaticResource TextSoftBrush}" StrokeThickness="2"
                        VerticalAlignment="Center" Margin="2,0,10,0" RenderTransformOrigin="0.5,0.5">
                    <Path.Style>
                      <Style TargetType="Path">
                        <Setter Property="RenderTransform">
                          <Setter.Value>
                            <RotateTransform Angle="0" />
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsTimelineOpen}" Value="True">
                            <Setter Property="RenderTransform">
                              <Setter.Value>
                                <RotateTransform Angle="90" />
                              </Setter.Value>
                            </Setter>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Path.Style>
                  </Path>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding TimelineSummary}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                             Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" AutomationProperties.AutomationId="TimelineSummary" />
                  <TextBlock VerticalAlignment="Center">
                    <Run Text="Timeline" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" />
                    <Run Text="  Which reference goes into which shot" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                  </TextBlock>
                </DockPanel>
              </Button>

              <StackPanel Margin="0,10,0,0" Visibility="{Binding IsTimelineOpen, Converter={StaticResource Visible}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="shot · starts at" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding TimelineShots}" ItemsPanel="{StaticResource ShotColumns}" ItemContainerStyle="{StaticResource ShotColumnStyle}"
                                Focusable="False" AutomationProperties.Name="Shots">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type refs:TimelineShotViewModel}">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="4,2,0,4" ClipToBounds="True" ToolTip="{Binding ToolTip}" Background="Transparent">
                          <StackPanel>
                            <TextBlock x:Name="Label" Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextSoftBrush}" />
                            <TextBlock x:Name="Start" Text="{Binding StartText}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                          </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsLit}" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Start" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>

                <!-- One Tab stop for the whole grid; the arrow keys move inside it. -->
                <ItemsControl ItemsSource="{Binding TimelineRows}" Focusable="False" AutomationProperties.Name="References in the shots"
                              KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type refs:TimelineRowViewModel}">
                      <Border x:Name="Row" CornerRadius="6" Background="Transparent">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Button Command="{Binding PickCommand}" Template="{StaticResource BareButton}" Height="26" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="{Binding Name, StringFormat='Pick {0}'}" FocusVisualStyle="{StaticResource RoundedFocusVisual}">
                            <DockPanel Margin="4,0,8,0">
                              <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                              <TextBlock x:Name="RowName" Text="{Binding Name}" FontSize="12" Foreground="{StaticResource TextSoftBrush}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                          </Button>
                          <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" ItemsPanel="{StaticResource ShotColumns}" ItemContainerStyle="{StaticResource ShotColumnStyle}"
                                        ItemTemplate="{StaticResource TimelineCellTemplate}" Focusable="False" AutomationProperties.Name="{Binding Name, StringFormat='Shots with {0}'}" />
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                          <Setter TargetName="RowName" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                          <Setter TargetName="RowName" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,2,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="per shot (max 4)" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding TimelineShots}" ItemsPanel="{StaticResource ShotColumns}" ItemContainerStyle="{StaticResource ShotColumnStyle}"
                                Focusable="False" AutomationProperties.Name="How many are in each shot">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type refs:TimelineShotViewModel}">
                        <Border x:Name="Count" Margin="2,3,2,0" Padding="0,2" CornerRadius="4" Background="Transparent" ToolTip="{Binding ToolTip}">
                          <TextBlock x:Name="CountText" Text="{Binding CountText}" FontFamily="{StaticResource MonoFont}" FontSize="10" HorizontalAlignment="Center"
                                     Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsFull}" Value="True">
                            <Setter TargetName="Count" Property="Background" Value="{StaticResource PillErrorBackBrush}" />
                            <Setter TargetName="CountText" Property="Foreground" Value="{StaticResource PillErrorTextBrush}" />
                            <Setter TargetName="CountText" Property="FontWeight" Value="Bold" />
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>

                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="4,10,0,0"
                           Text="Click a cell to add or remove a reference for that shot. Minimax takes up to 4 per clip, so a full shot takes no more. Picking a reference lights up the shots it is in." />
              </StackPanel>
            </StackPanel>
          </Border>

          <TextBlock Text="Shown once, or in no shot (no reference)" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6" />
          <ItemsControl ItemsSource="{Binding Others}" Focusable="False" AutomationProperties.Name="The rest of the cast">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type refs:OtherCastItem}">
                <DockPanel Margin="0,0,0,6">
                  <Button DockPanel.Dock="Right" Content="Make it a reference" Style="{StaticResource SmallButtonStyle}"
                          Command="{Binding DataContext.MakeReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Name}"
                          AutomationProperties.Name="{Binding Name, StringFormat='Make {0} a reference'}" />
                  <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{StaticResource TextSoftBrush}" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- The image pool. -->
      <Border Grid.Column="1" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,16,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="IMAGE POOL" Style="{StaticResource SectionLabelStyle}" />
            <TextBlock Text="{Binding PoolSummary}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                     Text="Kept from the project's sources. Input for Qwen only, never shown in the video." />
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Pool}" Focusable="False" AutomationProperties.Name="Image pool">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type refs:PoolPictureViewModel}">
                  <Button Command="{Binding SelectCommand}" Margin="0,0,0,8" Cursor="Hand" AutomationProperties.Name="{Binding}" FocusVisualStyle="{StaticResource RoundedFocusVisual}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Item" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="4" Background="#23262B" ClipToBounds="True" Margin="0,0,8,0">
                        <Image Source="{Binding Path, Converter={views:ThumbnailConverter}}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Caption}" FontSize="12" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                      </StackPanel>
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- The selected reference, or the selected pool picture. -->
      <Border Grid.Column="2" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20">
        <Grid>
          <TextBlock Text="Pick a card or a picture in the pool." FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                     Visibility="{Binding ShowsNothingSelected, Converter={StaticResource Visible}}" />

          <DockPanel Visibility="{Binding ShowsCard, Converter={StaticResource Visible}}">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <UniformGrid Columns="2">
                <Button Content="Approve" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Background="#58B7A6" Command="{Binding ApproveCommand}" AutomationProperties.Name="Approve the image" />
                <Button Content="Regenerate" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="4,0,0,0" Command="{Binding RegenerateCommand}" AutomationProperties.Name="Make the image again" />
              </UniformGrid>
              <UniformGrid Columns="2" Margin="0,8,0,0">
                <Button Content="Edit look…" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Margin="0,0,4,0" Command="{Binding StartEditLookCommand}" />
                <Button Content="+ image" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Margin="4,0,0,0" Command="{Binding AddImageCommand}" AutomationProperties.Name="Make one more image" />
              </UniformGrid>
              <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Merge" Style="{StaticResource SmallButtonStyle}" Margin="6,0,0,0" Command="{Binding MergeCommand}" AutomationProperties.Name="Merge into the reference picked" />
                <ComboBox ItemsSource="{Binding MergeChoices}" SelectedItem="{Binding MergeTarget}" AutomationProperties.Name="Merge with" ToolTip="Merge with…" />
              </DockPanel>
              <UniformGrid Columns="2" Margin="0,8,0,0">
                <Button Content="Add my own picture…" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36" Margin="0,0,4,0" Command="{Binding AddOwnPictureCommand}" />
                <Button Content="Remove from the list" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36" Margin="4,0,0,0" Command="{Binding RemoveCommand}" />
              </UniformGrid>
              <!-- The stills that use this image, made again; asks first with how many. -->
              <Button Content="Rerun pipeline from here ↓" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Margin="0,8,0,0" Command="{Binding RerunFromHereCommand}"
                      AutomationProperties.Name="Rerun pipeline from here" ToolTip="Makes the stills that use this image again." />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="SELECTED" Style="{StaticResource SectionLabelStyle}" />
                <TextBlock Text="{Binding SelectedName}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SelectedStatus}" FontSize="13" Foreground="{StaticResource TextSoftBrush}" Margin="0,2,0,10" />

                <Border Height="220" CornerRadius="8" Background="#23262B" ClipToBounds="True" Margin="0,0,0,10">
                  <Image Source="{Binding PreviewPath, Converter={views:ThumbnailConverter}, ConverterParameter=800}" Stretch="Uniform" />
                </Border>

                <ItemsControl ItemsSource="{Binding ImageChoices}" ItemsPanel="{StaticResource WrapItems}" Focusable="False" Margin="0,0,0,8" AutomationProperties.Name="Images">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type refs:ReferenceImageChoice}">
                      <Button Content="{Binding Label}" Style="{StaticResource SmallButtonStyle}" Margin="0,0,6,6"
                              Command="{Binding DataContext.SelectImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Image.Number}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Remove this image" Style="{StaticResource SmallButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,10" Command="{Binding RemoveImageCommand}"
                        ToolTip="Only when there are others: e.g. one that came out with nothing on it." />
                <!-- A rerun waits on this image. -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                        Visibility="{Binding RerunText, Converter={views:NullToCollapsedConverter}}">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Stop rerun" Style="{StaticResource SmallButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding StopRerunCommand}" />
                    <TextBlock Text="{Binding RerunText}" FontSize="13" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="ImageRerun" />
                  </DockPanel>
                </Border>

                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" Visibility="{Binding ShowsPartial, Converter={StaticResource Visible}}">
                  <StackPanel>
                    <TextBlock Text="{Binding MadeUpText}" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" FontSize="13" />
                    <TextBlock Text="The pictures found show only part of it. Qwen filled in the rest, so look closely before you approve." FontSize="12"
                               Foreground="#D9C9A8" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <Button Content="Add a better picture…" Style="{StaticResource SmallButtonStyle}" HorizontalAlignment="Left" Command="{Binding AddOwnPictureCommand}" />
                  </StackPanel>
                </Border>

                <Border Background="{StaticResource PillErrorBackBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" Visibility="{Binding ShowsMissing, Converter={StaticResource Visible}}">
                  <StackPanel>
                    <TextBlock Text="No usable picture" FontWeight="SemiBold" Foreground="{StaticResource PillErrorTextBrush}" FontSize="13" />
                    <TextBlock FontSize="12" Foreground="#E2C1BB" TextWrapping="Wrap" Margin="0,4,0,8">
                      <Run Text="{Binding MissingWhy, Mode=OneWay}" /> Nothing is made until you choose:
                    </TextBlock>
                    <Button Content="Search sources again" Style="{StaticResource SmallButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,6" Command="{Binding SearchAgainCommand}" />
                    <Button Content="Add my own picture…" Style="{StaticResource SmallButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,6" Command="{Binding AddOwnPictureCommand}" />
                    <Button Content="Make it from the description only" Style="{StaticResource SmallButtonStyle}" HorizontalAlignment="Left" Command="{Binding FromDescriptionCommand}" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBoxStyle}" Margin="0,0,0,10" Visibility="{Binding ShowsAsIs, Converter={StaticResource Visible}}">
                  <StackPanel>
                    <TextBlock Text="Your picture, as it is" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="No model made this image: it is the picture you chose, unchanged. Regenerate makes one with the project's reference model." FontSize="12"
                               Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Versions}" ItemsPanel="{StaticResource WrapItems}" Focusable="False" Margin="0,0,0,10" AutomationProperties.Name="Versions">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type script:SegmentVersionChoice}">
                      <Button Content="{Binding Label}" Margin="0,0,6,6" FontFamily="{StaticResource MonoFont}" Style="{StaticResource SmallButtonStyle}"
                              Command="{Binding DataContext.ShowVersionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Version}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Made from (Qwen image-to-image)" Style="{StaticResource FieldLabelStyle}" />
                <ItemsControl ItemsSource="{Binding MadeFrom}" Focusable="False" Margin="0,0,0,10" AutomationProperties.Name="Made from">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource TextSoftBrush}" Margin="0,0,0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Look (goes into every prompt that shows it)" Style="{StaticResource FieldLabelStyle}" />
                <Border Style="{StaticResource PanelBoxStyle}" Margin="0,0,0,10" Visibility="{Binding IsNotEditingLook, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding Look}" FontSize="13" TextWrapping="Wrap" />
                </Border>
                <StackPanel Visibility="{Binding IsEditingLook, Converter={StaticResource Visible}}" Margin="0,0,0,10">
                  <TextBox Text="{Binding EditLook, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top"
                           FontSize="13" Padding="8,6" AutomationProperties.Name="Look" />
                  <UniformGrid Columns="2" Margin="0,6,0,0">
                    <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Command="{Binding SaveLookCommand}" AutomationProperties.Name="Save the look" />
                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Margin="4,0,0,0" Command="{Binding CancelLookCommand}" AutomationProperties.Name="Cancel the look" />
                  </UniformGrid>
                </StackPanel>

                <TextBlock Text="In the shots" Style="{StaticResource FieldLabelStyle}" />
                <ItemsControl ItemsSource="{Binding SelectedShots}" ItemsPanel="{StaticResource WrapItems}" Focusable="False" AutomationProperties.Name="In the shots">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource CardBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,4,4">
                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextSoftBrush}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

          <StackPanel Visibility="{Binding ShowsPicture, Converter={StaticResource Visible}}">
            <TextBlock Text="IMAGE IN THE POOL" Style="{StaticResource SectionLabelStyle}" />
            <TextBlock Text="{Binding SelectedPicture.Caption}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0" />
            <TextBlock Text="{Binding SelectedPicture.Meta}" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,10" />
            <Border Height="220" CornerRadius="8" Background="#23262B" ClipToBounds="True" Margin="0,0,0,10">
              <Image Source="{Binding SelectedPicture.Path, Converter={views:ThumbnailConverter}, ConverterParameter=800}" Stretch="Uniform" />
            </Border>
            <TextBlock Text="Too small to work from: Qwen needs about 512 px on the short side. Kept here in case nothing better turns up." FontSize="12"
                       Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding SelectedPicture.TooSmall, Converter={StaticResource Visible}, FallbackValue=Collapsed}" />
            <TextBlock Text="Source image for" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{Binding UseForChoices}" SelectedItem="{Binding UseFor}" AutomationProperties.Name="Source image for" Margin="0,0,0,6" />
            <UniformGrid Columns="2" Margin="0,0,0,6">
              <Button Content="Use it" Style="{StaticResource SmallButtonStyle}" Margin="0,0,3,0" Command="{Binding UsePictureCommand}" AutomationProperties.Name="Use the picture" />
              <Button Content="Use it as it is" Style="{StaticResource SmallButtonStyle}" Margin="3,0,0,0" Command="{Binding UseAsItIsCommand}"
                      AutomationProperties.Name="Use the picture as it is" ToolTipService.ShowOnDisabled="True"
                      ToolTip="Once the images are made: the picture becomes the reference's first image." />
            </UniformGrid>
            <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Use it: the reference model makes the reference image from this picture. Use it as it is: this picture is the reference image, unchanged; Regenerate on the reference still makes one with the model." />
            <UniformGrid Columns="2">
              <Button Content="Open the page" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Margin="0,0,4,0" Command="{Binding OpenPageCommand}" />
              <Button Content="Discard" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Margin="4,0,0,0" Command="{Binding DiscardPictureCommand}" AutomationProperties.Name="Discard from the pool" />
            </UniformGrid>
            <TextBlock Text="Input for Qwen only: it shapes the reference, and never appears in the video itself." FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,10,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
