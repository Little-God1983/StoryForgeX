<UserControl x:Class="StoryForge.App.Views.AssemblyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:asm="clr-namespace:StoryForge.App.ViewModels.Assembly"
             xmlns:views="clr-namespace:StoryForge.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=asm:AssemblyViewModel}">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style x:Key="BarStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="LabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- The timeline's blocks: each as wide as its shot lasts. -->
    <ItemsPanelTemplate x:Key="ShotColumns">
      <views:WeightedPanel />
    </ItemsPanelTemplate>

    <Style x:Key="ShotColumnStyle" TargetType="ContentPresenter">
      <Setter Property="views:WeightedPanel.Weight" Value="{Binding Seconds}" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="380" />
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <!-- The bars: one for the stage as it stands. -->
        <Border Style="{StaticResource BarStyle}" Background="#172536" BorderBrush="#2B4A66" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36" Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel cutting the video" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding BarText}" FontSize="14" FontWeight="SemiBold" Foreground="#6FB3EE" />
              <TextBlock Text="{Binding Activity}" FontSize="12" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                         Visibility="{Binding Activity, Converter={views:NullToCollapsedConverter}}" AutomationProperties.AutomationId="AssemblyActivity" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource BarStyle}" Background="{StaticResource AccentSoftBrush}" BorderBrush="#5A4520" Visibility="{Binding IsReview, Converter={StaticResource Visible}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Approve video" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13" Margin="8,0,0,0"
                    Command="{Binding ApproveCommand}" AutomationProperties.Name="Approve the video" />
            <Button DockPanel.Dock="Right" Content="Regenerate cut list" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"
                    Command="{Binding RegenerateCommand}" AutomationProperties.Name="Regenerate the cut list" />
            <TextBlock Text="Gate: Assembly" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock Text="{Binding BarText}" VerticalAlignment="Center" FontSize="13" Foreground="#D9C9A8" TextWrapping="Wrap" AutomationProperties.AutomationId="AssemblyBar" />
          </DockPanel>
        </Border>

        <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillOkBackBrush}" BorderBrush="#2F5A50" Visibility="{Binding IsApproved, Converter={StaticResource Visible}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Regenerate cut list" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36"
                    Command="{Binding RegenerateCommand}" AutomationProperties.Name="Regenerate the cut list" />
            <TextBlock Text="{Binding BarText}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource PillOkTextBrush}" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillErrorBackBrush}" BorderBrush="#5A2E2A" Visibility="{Binding IsFailed, Converter={StaticResource Visible}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" Command="{Binding RetryCommand}"
                    AutomationProperties.Name="Retry cutting the video" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding BarText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PillErrorTextBrush}" />
              <TextBlock Text="{Binding Error}" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="AssemblyError" />
            </StackPanel>
          </DockPanel>
        </Border>

        <Border Style="{StaticResource BarStyle}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" Visibility="{Binding IsNotStarted, Converter={StaticResource Visible}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Cut the video" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" Command="{Binding MakeVideoCommand}"
                    AutomationProperties.Name="Cut the video" />
            <TextBlock Text="{Binding BarText}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <TextBlock Text="{Binding Stale}" FontSize="13" Foreground="#B4A8F5" TextWrapping="Wrap" Margin="0,0,0,10"
                   Visibility="{Binding Stale, Converter={views:NullToCollapsedConverter}}" AutomationProperties.AutomationId="AssemblyStale" />
        <TextBlock Text="{Binding Error}" FontSize="13" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                   AutomationProperties.AutomationId="AssemblyRefused">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>

        <!-- The video and its versions. -->
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="200" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <Border CornerRadius="10" Background="#0B0C0E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinHeight="200">
              <Grid>
                <TextBlock Text="No video yet." FontSize="13" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding VideoPath, Converter={views:NullToVisibleConverter}}" />
                <MediaElement x:Name="Player" Source="{Binding VideoPath}" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MaxHeight="420"
                              ScrubbingEnabled="True" MediaOpened="VideoOpened" AutomationProperties.Name="The video" />
              </Grid>
            </Border>
            <UniformGrid Columns="2" Margin="0,8,0,0" Visibility="{Binding VideoPath, Converter={views:NullToCollapsedConverter}}">
              <Button Content="Play" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13" Margin="0,0,4,0" Click="PlayVideo" AutomationProperties.Name="Play the video" />
              <Button Content="Pause" Style="{StaticResource SecondaryButtonStyle}" MinHeight="36" Margin="4,0,0,0" Click="PauseVideo" AutomationProperties.Name="Pause the video" />
            </UniformGrid>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="VERSIONS" Style="{StaticResource LabelStyle}" />
            <ItemsControl ItemsSource="{Binding Versions}" AutomationProperties.Name="Versions">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type asm:AssemblyVersionViewModel}">
                  <Button Content="{Binding Label}" Command="{Binding ShowCommand}" Margin="0,0,6,6" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="{Binding Label}">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsShown}" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="SOUND" Style="{StaticResource LabelStyle}" Margin="0,12,0,6" />
            <TextBlock Text="Narration 0 dB" FontSize="13" Margin="0,0,0,6" />
            <DockPanel Margin="0,0,0,6">
              <TextBlock DockPanel.Dock="Right" Text="dB" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" />
              <TextBlock DockPanel.Dock="Left" Text="Clip sound" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Text="{Binding ClipSound, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Clip sound in dB" />
            </DockPanel>
            <TextBlock Text="Minimax's own sound, as a quiet bed under the voice. Changing it renders again." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <!-- The cut list: one block per shot, storyboard order, the cut after it marked. -->
        <DockPanel Margin="0,0,0,6">
          <TextBlock DockPanel.Dock="Right" Text="{Binding VideoInfo}" FontSize="12" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" />
          <TextBlock Text="Cut list · one block per shot, in storyboard order · the narration is fixed, the cuts move around it" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Blocks}" ItemsPanel="{StaticResource ShotColumns}" ItemContainerStyle="{StaticResource ShotColumnStyle}" AutomationProperties.Name="Cut list">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type asm:CutBlockViewModel}">
              <Button Command="{Binding SelectCommand}" Cursor="Hand" ToolTip="{Binding AccessibleName}" AutomationProperties.Name="{Binding AccessibleName}"
                      FocusVisualStyle="{StaticResource RoundedFocusVisual}">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <StackPanel>
                      <Border x:Name="Block" Height="48" Background="#1D2A27" BorderBrush="#0F1012" BorderThickness="0,0,1,0" Padding="4,2" ClipToBounds="True">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Shot.Label}" FontSize="11" FontWeight="SemiBold" Foreground="#7FD1C2" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding SecondsText}" FontSize="10" Foreground="#7FD1C2" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Border>
                      <TextBlock Text="{Binding Mark}" FontSize="10" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                 Foreground="{StaticResource TextSoftBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                      <DataTrigger Binding="{Binding IsYours}" Value="True">
                        <Setter TargetName="Block" Property="Background" Value="#263A35" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Block" Property="Background" Value="#2A2418" />
                        <Setter TargetName="Block" Property="BorderBrush" Value="#ECEBE7" />
                        <Setter TargetName="Block" Property="BorderThickness" Value="2" />
                      </DataTrigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Height="14" CornerRadius="4" Background="#23303A" Margin="0,6,0,0">
          <TextBlock Text="narration" FontSize="10" Foreground="#8FC3EA" Margin="8,0" VerticalAlignment="Center" />
        </Border>
        <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                   Text="|  cut   ·   ◇  crossfade   ·   ■  dip to black   ·   J / L  the clips' sound changes before / after the picture   ·   lighter block: your edit" />
      </StackPanel>
    </ScrollViewer>

    <!-- The selected cut. -->
    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <TextBlock Text="Your edits collect in a new version; Render again makes its video. The clips are cropped to the delivery only in the render: the clip files are never changed."
                     FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
          <Button Content="Render again with my edits" Style="{StaticResource PrimaryButtonStyle}" MinHeight="40" Command="{Binding RenderAgainCommand}"
                  AutomationProperties.Name="Render again with my edits" />
          <Button Content="Undo my edits" Style="{StaticResource SecondaryButtonStyle}" MinHeight="34" Margin="0,8,0,0" Command="{Binding UndoCommand}"
                  AutomationProperties.Name="Undo my edits" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="SELECTED CUT" Style="{StaticResource LabelStyle}" />
          <TextBlock Text="{Binding EditBlocked}" FontSize="13" Foreground="#B4A8F5" TextWrapping="Wrap" Margin="0,0,0,8"
                     Visibility="{Binding EditBlocked, Converter={views:NullToCollapsedConverter}}" AutomationProperties.AutomationId="EditBlocked" />
          <TextBlock Text="Pick a shot on the cut list to see the cut after it." FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                     Visibility="{Binding HasSelection, Converter={views:FalseToVisibleConverter}}" />
          <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding CutHeading}" FontSize="18" FontWeight="Bold" Margin="0,0,0,2" AutomationProperties.AutomationId="CutHeading" />
            <TextBlock Text="{Binding CutWords}" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

            <TextBlock Text="Where the picture changes (inside the 0.5 s handles)" Style="{StaticResource LabelStyle}" />
            <DockPanel Margin="0,0,0,14">
              <Button DockPanel.Dock="Left" Content="◀ 0.1 s" Style="{StaticResource SmallButtonStyle}" Command="{Binding EarlierCommand}" AutomationProperties.Name="Cut 0.1 s earlier" />
              <Button DockPanel.Dock="Right" Content="0.1 s ▶" Style="{StaticResource SmallButtonStyle}" Command="{Binding LaterCommand}" AutomationProperties.Name="Cut 0.1 s later" />
              <TextBlock Text="{Binding ShiftText}" FontFamily="{StaticResource MonoFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                         AutomationProperties.AutomationId="CutShift" />
            </DockPanel>

            <TextBlock Text="Transition" Style="{StaticResource LabelStyle}" />
            <ComboBox ItemsSource="{x:Static asm:AssemblyViewModel.Transitions}" SelectedItem="{Binding Transition}" Margin="0,0,0,8" AutomationProperties.Name="Transition">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={views:TransitionNameConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <DockPanel Margin="0,0,0,14">
              <TextBlock DockPanel.Dock="Left" Text="Length" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock DockPanel.Dock="Right" Text="s" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" />
              <TextBox Text="{Binding TransitionSeconds, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Transition length in seconds" />
            </DockPanel>

            <TextBlock Text="The clips' sound changes (+ before the picture, − after)" Style="{StaticResource LabelStyle}" />
            <DockPanel Margin="0,0,0,4">
              <TextBlock DockPanel.Dock="Right" Text="s" FontSize="13" VerticalAlignment="Center" Margin="6,0,0,0" />
              <TextBox Text="{Binding SoundLead, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Sound change in seconds" />
            </DockPanel>
            <TextBlock Text="{Binding SoundText}" FontSize="12" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

            <TextBlock Text="{Binding EditProblem}" FontSize="12" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Visibility="{Binding EditProblem, Converter={views:NullToCollapsedConverter}}" />

            <TextBlock Text="Why (Claude)" Style="{StaticResource LabelStyle}" />
            <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
              <TextBlock Text="{Binding CutWhy}" FontSize="13" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
