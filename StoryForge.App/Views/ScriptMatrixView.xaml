<UserControl x:Class="StoryForge.App.Views.ScriptMatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:client="clr-namespace:StoryForge.Client;assembly=StoryForge.Client"
             xmlns:script="clr-namespace:StoryForge.App.ViewModels.Script"
             xmlns:views="clr-namespace:StoryForge.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=script:ScriptMatrixViewModel}">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style x:Key="BarStyle" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- A Script cell: coloured by state as in the canvas legend; the selected one has a light border. -->
    <Style x:Key="CellStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="44">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding DisplayState}" Value="{x:Static client:StageState.NeedsReview}">
          <Setter Property="Background" Value="{StaticResource PillOffBackBrush}" />
          <Setter Property="Foreground" Value="{StaticResource PillOffTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding DisplayState}" Value="{x:Static client:StageState.Approved}">
          <Setter Property="Background" Value="{StaticResource PillOkBackBrush}" />
          <Setter Property="Foreground" Value="{StaticResource PillOkTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding DisplayState}" Value="{x:Static client:StageState.Running}">
          <Setter Property="Background" Value="#172536" />
          <Setter Property="Foreground" Value="#6FB3EE" />
        </DataTrigger>
        <DataTrigger Binding="{Binding DisplayState}" Value="{x:Static client:StageState.Failed}">
          <Setter Property="Background" Value="{StaticResource PillErrorBackBrush}" />
          <Setter Property="Foreground" Value="{StaticResource PillErrorTextBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding DisplayState}" Value="{x:Static client:StageState.Stale}">
          <Setter Property="Background" Value="{StaticResource NoteBackBrush}" />
          <Setter Property="Foreground" Value="#B4A8F5" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- A cell of a stage that comes later: not started. -->
    <Style x:Key="LaterCellStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <!-- Where the script stands: one bar per state. -->
    <StackPanel DockPanel.Dock="Top">
      <Border Style="{StaticResource BarStyle}" Background="{StaticResource AccentSoftBrush}" BorderBrush="#5A4520"
              Visibility="{Binding IsReview, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Approve remaining" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Margin="8,0,0,0" Command="{Binding ApproveRemainingCommand}" />
          <Button DockPanel.Dock="Right" Content="Regenerate script" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RegenerateScriptCommand}" />
          <TextBlock Text="Gate: Script" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#D9C9A8" TextWrapping="Wrap">
            <Run Text="{Binding ApprovedSummary, Mode=OneWay}" /> The run goes on when every segment is approved.
          </TextBlock>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillOkBackBrush}" BorderBrush="#2F5A50"
              Visibility="{Binding IsApproved, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Regenerate script" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RegenerateScriptCommand}" />
          <TextBlock Text="Script approved" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PillOkTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                     Text="Every segment is approved. A change to one makes a new version that needs approving again." />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="#172536" BorderBrush="#2B4A6B"
              Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelCommand}" />
          <TextBlock Text="Writing the script" FontSize="14" FontWeight="SemiBold" Foreground="#6FB3EE" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#BCD3EA" TextWrapping="Wrap"
                     Text="From the approved fact sheet and nothing else. The segments appear here when it is done." />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillErrorBackBrush}" BorderBrush="#6B3A33"
              Visibility="{Binding IsFailed, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Background="{StaticResource ErrorTextBrush}" Command="{Binding RegenerateScriptCommand}" />
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Script failed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PillErrorTextBrush}" />
            <TextBlock Text="{Binding Error}" FontSize="13" Foreground="#E2C1BB" TextWrapping="Wrap" Margin="0,2,0,0"
                       AutomationProperties.AutomationId="ScriptError" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
              Visibility="{Binding IsNotStarted, Converter={StaticResource Visible}}">
        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                   Text="The script is written as soon as the fact sheet is approved: one row per segment." />
      </Border>

      <!-- Where the voice stands, once the script is approved. -->
      <Border Style="{StaticResource BarStyle}" Background="#172536" BorderBrush="#2B4A6B"
              Visibility="{Binding IsVoiceRunning, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelVoiceCommand}"
                  AutomationProperties.Name="Cancel the voice" />
          <TextBlock Text="Speaking the script" FontSize="14" FontWeight="SemiBold" Foreground="#6FB3EE" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock Text="{Binding VoiceProgress}" VerticalAlignment="Center" FontSize="13" Foreground="#BCD3EA" TextTrimming="CharacterEllipsis"
                     FontFamily="{StaticResource MonoFont}" AutomationProperties.AutomationId="VoiceProgress" />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource AccentSoftBrush}" BorderBrush="#5A4520"
              Visibility="{Binding IsVoiceReview, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Approve remaining" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Margin="8,0,0,0" Command="{Binding ApproveRemainingVoiceCommand}" AutomationProperties.Name="Approve remaining voice" />
          <Button DockPanel.Dock="Right" Content="Regenerate voice" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RegenerateVoiceCommand}" />
          <TextBlock Text="Gate: Voice" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#D9C9A8" TextWrapping="Wrap">
            <Run Text="{Binding VoiceApprovedSummary, Mode=OneWay}" /> Listen to each segment; the run goes on when every one is approved.
          </TextBlock>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillOkBackBrush}" BorderBrush="#2F5A50"
              Visibility="{Binding IsVoiceApproved, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Regenerate voice" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RegenerateVoiceCommand}" />
          <TextBlock Text="Voice approved" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PillOkTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                     Text="Every segment is spoken. Select a Voice cell to listen; Regenerate there speaks one segment again." />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillErrorBackBrush}" BorderBrush="#6B3A33"
              Visibility="{Binding IsVoiceFailed, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Background="{StaticResource ErrorTextBrush}" Command="{Binding RegenerateVoiceCommand}" AutomationProperties.Name="Retry the voice" />
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Voice failed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PillErrorTextBrush}" />
            <TextBlock Text="{Binding VoiceError}" FontSize="13" Foreground="#E2C1BB" TextWrapping="Wrap" Margin="0,2,0,0"
                       AutomationProperties.AutomationId="VoiceError" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Where the storyboard stands, once the voice is approved. -->
      <Border Style="{StaticResource BarStyle}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
              Visibility="{Binding CanPlanBoard, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Plan the storyboard" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Command="{Binding RegenerateBoardCommand}" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                     Text="The voice is approved. The storyboard cuts every segment into shots, timed to its words." />
        </DockPanel>
      </Border>
      <Border Style="{StaticResource BarStyle}" Background="#172536" BorderBrush="#2B4A6B"
              Visibility="{Binding IsBoardRunning, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelBoardCommand}"
                  AutomationProperties.Name="Cancel the storyboard" />
          <TextBlock Text="Planning the shots" FontSize="14" FontWeight="SemiBold" Foreground="#6FB3EE" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock Text="{Binding BoardProgress}" VerticalAlignment="Center" FontSize="13" Foreground="#BCD3EA" TextTrimming="CharacterEllipsis"
                     FontFamily="{StaticResource MonoFont}" AutomationProperties.AutomationId="BoardProgress" />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource AccentSoftBrush}" BorderBrush="#5A4520"
              Visibility="{Binding IsBoardReview, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Approve remaining" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Margin="8,0,0,0" Command="{Binding ApproveRemainingBoardCommand}" AutomationProperties.Name="Approve remaining shots" />
          <Button DockPanel.Dock="Right" Content="Regenerate storyboard" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RegenerateBoardCommand}" />
          <TextBlock Text="Gate: Storyboard" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#D9C9A8" TextWrapping="Wrap">
            <Run Text="{Binding BoardApprovedSummary, Mode=OneWay}" /> This stop is always on: References start when every shot is approved.
          </TextBlock>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillOkBackBrush}" BorderBrush="#2F5A50"
              Visibility="{Binding IsBoardApproved, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Regenerate storyboard" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RegenerateBoardCommand}" />
          <TextBlock Text="Storyboard approved" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PillOkTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                     Text="Every shot is approved. The references are proposed next: open them with the References chip above." />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillErrorBackBrush}" BorderBrush="#6B3A33"
              Visibility="{Binding IsBoardFailed, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Retry" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Background="{StaticResource ErrorTextBrush}" Command="{Binding RegenerateBoardCommand}" AutomationProperties.Name="Retry the storyboard" />
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Storyboard failed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PillErrorTextBrush}" />
            <TextBlock Text="{Binding BoardError}" FontSize="13" Foreground="#E2C1BB" TextWrapping="Wrap" Margin="0,2,0,0"
                       AutomationProperties.AutomationId="BoardError" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Where the stills stand, once the references are approved. -->
      <Border Style="{StaticResource BarStyle}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
              Visibility="{Binding CanMakeStills, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Make the stills" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Command="{Binding ContinuePipelineCommand}" />
          <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                     Text="The references are approved. Every shot gets one still, made from the reference images of who and what is in it." />
        </DockPanel>
      </Border>
      <Border Style="{StaticResource BarStyle}" Background="#172536" BorderBrush="#2B4A6B"
              Visibility="{Binding IsStillsRunning, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelStillsCommand}"
                  AutomationProperties.Name="Cancel the stills" />
          <TextBlock Text="Making the stills" FontSize="14" FontWeight="SemiBold" Foreground="#6FB3EE" VerticalAlignment="Center" Margin="0,0,14,0" />
          <TextBlock Text="{Binding StillsProgress}" VerticalAlignment="Center" FontSize="13" Foreground="#BCD3EA" TextTrimming="CharacterEllipsis"
                     FontFamily="{StaticResource MonoFont}" AutomationProperties.AutomationId="StillsProgress" />
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource AccentSoftBrush}" BorderBrush="#5A4520"
              Visibility="{Binding IsStillsReview, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Continue pipeline" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Margin="8,0,0,0" Command="{Binding ContinuePipelineCommand}" />
          <Button DockPanel.Dock="Right" Content="Approve remaining" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ApproveRemainingStillsCommand}"
                  AutomationProperties.Name="Approve remaining stills" />
          <TextBlock Text="Gate: Stills" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="13" Foreground="#D9C9A8" TextWrapping="Wrap" AutomationProperties.AutomationId="StillsSummary">
              <Run Text="{Binding StillsApprovedSummary, Mode=OneWay}" /> Clips start when every still is approved.
            </TextBlock>
            <TextBlock Text="{Binding QueuedSummary}" FontSize="12" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding HasQueuedStills, Converter={StaticResource Visible}}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillOkBackBrush}" BorderBrush="#2F5A50"
              Visibility="{Binding IsStillsApproved, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Continue pipeline" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Command="{Binding ContinuePipelineCommand}" Visibility="{Binding HasQueuedStills, Converter={StaticResource Visible}}" />
          <TextBlock Text="Stills approved" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PillOkTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                       Text="Every still is approved. Select a Still cell to look at it; Regenerate there puts it in the batch." />
            <TextBlock Text="{Binding QueuedSummary}" FontSize="12" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding HasQueuedStills, Converter={StaticResource Visible}}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource BarStyle}" Background="{StaticResource PillErrorBackBrush}" BorderBrush="#6B3A33"
              Visibility="{Binding IsStillsFailed, Converter={StaticResource Visible}}">
        <DockPanel>
          <!-- Continue pipeline makes what is waiting: the stills the run did not get to, and the batch; those made stay. -->
          <Button DockPanel.Dock="Right" Content="Continue pipeline" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" FontSize="13"
                  Background="{StaticResource ErrorTextBrush}" Command="{Binding ContinuePipelineCommand}" AutomationProperties.Name="Continue the stills" />
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Stills failed" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PillErrorTextBrush}" />
            <TextBlock Text="{Binding StillsError}" FontSize="13" Foreground="#E2C1BB" TextWrapping="Wrap" Margin="0,2,0,0"
                       AutomationProperties.AutomationId="StillsError" />
            <TextBlock Text="{Binding QueuedSummary}" FontSize="12" Foreground="#E2C1BB" TextWrapping="Wrap" Margin="0,2,0,0"
                       Visibility="{Binding HasQueuedStills, Converter={StaticResource Visible}}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Background="{StaticResource PillErrorBackBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
              Visibility="{Binding ActionError, Converter={views:NullToCollapsedConverter}}">
        <TextBlock Text="{Binding ActionError}" Foreground="{StaticResource PillErrorTextBrush}" FontSize="13" TextWrapping="Wrap" />
      </Border>

      <StackPanel Margin="0,0,0,12" Visibility="{Binding HasSegments, Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Show whole script" Style="{StaticResource SmallButtonStyle}" VerticalAlignment="Center"
                  Command="{Binding DataContext.ShowWholeScriptCommand, RelativeSource={RelativeSource AncestorType=views:ResultMatrixView}}" />
          <TextBlock Text="{Binding LengthSummary}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                     VerticalAlignment="Center" AutomationProperties.AutomationId="ScriptLength" />
        </DockPanel>
        <TextBlock Text="{Binding LengthNote}" FontSize="13" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding LengthNote, Converter={views:NullToCollapsedConverter}}" />
        <TextBlock Text="{Binding PacingSummary}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"
                   AutomationProperties.AutomationId="PacingSummary"
                   Visibility="{Binding PacingSummary, Converter={views:NullToCollapsedConverter}}" />
      </StackPanel>
    </StackPanel>

    <Grid>
      <!-- While the whole script is written (or failed before it had segments): the log. -->
      <DockPanel Visibility="{Binding ShowsLog, Converter={StaticResource Visible}}">
        <TextBlock DockPanel.Dock="Top" Text="WHAT THE SCRIPT WRITER DID" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,8" />
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Activity}" ItemTemplate="{StaticResource ActivityLineTemplate}"
                          FontFamily="{StaticResource MonoFont}" FontSize="13" Focusable="False" AutomationProperties.Name="Script activity" />
          </ScrollViewer>
        </Border>
      </DockPanel>

      <!-- The matrix: one row per segment, and the selected segment on the right. -->
      <Grid Visibility="{Binding HasSegments, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,20,0">
          <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="0,0,10,0">
              <Button DockPanel.Dock="Right" Content="{Binding FoldAllLabel}" Style="{StaticResource SmallButtonStyle}" Padding="8,2" FontSize="11"
                      Command="{Binding FoldAllCommand}" Visibility="{Binding ShowsFoldAll, Converter={StaticResource Visible}}" />
              <TextBlock Text="SEGMENT · SHOT" Style="{StaticResource SectionLabelStyle}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Column="1" Text="SCRIPT" Style="{StaticResource SectionLabelStyle}" />
            <TextBlock Grid.Column="2" Text="VOICE" Style="{StaticResource SectionLabelStyle}" Margin="6,0,0,0" />
            <TextBlock Grid.Column="3" Text="BOARD" Style="{StaticResource SectionLabelStyle}" Margin="6,0,0,0" />
            <TextBlock Grid.Column="4" Text="STILL" Style="{StaticResource SectionLabelStyle}" Margin="6,0,0,0" />
            <TextBlock Grid.Column="5" Text="CLIP" Style="{StaticResource SectionLabelStyle}" Margin="6,0,0,0" />
          </Grid>
          <!-- The colours of the cells, as the canvas legend has them. -->
          <WrapPanel DockPanel.Dock="Bottom" Margin="4,10,4,0" AutomationProperties.Name="Legend">
              <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                <Border Width="10" Height="10" CornerRadius="2" Background="#7FD1C2" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="approved" FontSize="12" Foreground="{StaticResource TextSoftBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                <Border Width="10" Height="10" CornerRadius="2" Background="#F0BD66" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="needs review" FontSize="12" Foreground="{StaticResource TextSoftBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                <Border Width="10" Height="10" CornerRadius="2" Background="#B4A8F5" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="stale (made from something that changed since)" FontSize="12" Foreground="{StaticResource TextSoftBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                <Border Width="10" Height="10" CornerRadius="2" Background="#6FB3EE" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="running" FontSize="12" Foreground="{StaticResource TextSoftBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                <Border Width="10" Height="10" CornerRadius="2" Background="#F08B7E" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="failed" FontSize="12" Foreground="{StaticResource TextSoftBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                <Border Width="10" Height="10" CornerRadius="2" Background="#8C9098" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="not started" FontSize="12" Foreground="{StaticResource TextSoftBrush}" />
              </StackPanel>
          </WrapPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="Segments">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type script:SegmentRowViewModel}">
                  <StackPanel>
                  <Grid Margin="4,0,4,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="220" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding ToggleCommand}" Cursor="Hand" Margin="0,0,10,0" HorizontalContentAlignment="Stretch"
                            IsEnabled="{Binding HasShots}" AutomationProperties.Name="{Binding Id, StringFormat='Fold or open {0}'}"
                            FocusVisualStyle="{StaticResource RoundedFocusVisual}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border Background="Transparent" Padding="0,2">
                            <ContentPresenter VerticalAlignment="Center" />
                          </Border>
                        </ControlTemplate>
                      </Button.Template>
                      <DockPanel>
                        <Path x:Name="Chevron" DockPanel.Dock="Left" Data="M 0 0 L 5 5 L 0 10" Stroke="{StaticResource TextSoftBrush}" StrokeThickness="2"
                              VerticalAlignment="Center" Margin="6,0,8,0" RenderTransformOrigin="0.5,0.5">
                          <Path.Style>
                            <Style TargetType="Path">
                              <Setter Property="Visibility" Value="Hidden" />
                              <Setter Property="RenderTransform">
                                <Setter.Value>
                                  <RotateTransform Angle="0" />
                                </Setter.Value>
                              </Setter>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasShots}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                  <Setter Property="RenderTransform">
                                    <Setter.Value>
                                      <RotateTransform Angle="90" />
                                    </Setter.Value>
                                  </Setter>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Path.Style>
                        </Path>
                        <StackPanel>
                          <TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                          <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                          <TextBlock Text="{Binding ShotsText}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}"
                                     Visibility="{Binding HasShots, Converter={StaticResource Visible}}" />
                        </StackPanel>
                      </DockPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource CellStyle}" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AccessibleName}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                      </DockPanel>
                    </Button>
                    <Button Grid.Column="2" DataContext="{Binding Voice}" Style="{StaticResource CellStyle}" Margin="6,0,0,0"
                            Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AccessibleName}">
                      <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LengthText}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                      </DockPanel>
                    </Button>
                    <!-- Folded: what the shots need, in the Board column. -->
                    <Border Grid.Column="3" Style="{StaticResource LaterCellStyle}">
                      <TextBlock Text="{Binding BoardSummary}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextSoftBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding BoardSummaryName}"
                                 Visibility="{Binding ShowsSummary, Converter={StaticResource Visible}}" />
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource LaterCellStyle}">
                      <TextBlock Text="{Binding StillSummary}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextSoftBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding StillSummaryName}"
                                 Visibility="{Binding ShowsSummary, Converter={StaticResource Visible}}" />
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource LaterCellStyle}" />
                  </Grid>

                  <!-- Its shots, indented: each with its Board and Still cells; Clip arrives with #12. -->
                  <ItemsControl ItemsSource="{Binding Shots}" Focusable="False" AutomationProperties.Name="{Binding Id, StringFormat='Shots of {0}'}"
                                Visibility="{Binding ShowsShots, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type script:ShotRowViewModel}">
                        <Grid Margin="4,0,4,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="36,0,10,0">
                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                          </StackPanel>
                          <Button Grid.Column="3" Style="{StaticResource CellStyle}" Margin="6,0,0,0" Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AccessibleName}">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" FontFamily="{StaticResource MonoFont}" />
                              <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                            </DockPanel>
                          </Button>
                          <Button Grid.Column="4" DataContext="{Binding Still}" Style="{StaticResource CellStyle}" Margin="6,0,0,0"
                                  Command="{Binding SelectCommand}" AutomationProperties.Name="{Binding AccessibleName}">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" FontFamily="{StaticResource MonoFont}" />
                              <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" />
                            </DockPanel>
                          </Button>
                          <Border Grid.Column="5" Style="{StaticResource LaterCellStyle}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- The selected segment. -->
        <Border Grid.Column="1" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20"
                Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Visibility="{Binding IsNotEditingAny, Converter={StaticResource Visible}}">
              <UniformGrid Columns="2">
                <Button Content="Approve" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Background="#58B7A6" Command="{Binding ApproveSegmentCommand}" />
                <Grid Margin="4,0,0,0">
                  <!-- A segment's Regenerate opens the note line first; a voice's or a shot's makes it again at once. -->
                  <Button Content="Regenerate" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Command="{Binding AskNoteCommand}"
                          Visibility="{Binding IsScriptPanel, Converter={StaticResource Visible}}" />
                  <Button Content="Regenerate" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Command="{Binding RegenerateSegmentCommand}"
                          Visibility="{Binding IsNotScriptPanel, Converter={StaticResource Visible}}" />
                </Grid>
              </UniformGrid>
              <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,8,0,0"
                      Visibility="{Binding IsAskingNote, Converter={StaticResource Visible}}">
                <StackPanel>
                  <TextBlock Text="Why write it again? (optional, e.g. too long)" Style="{StaticResource FieldLabelStyle}" />
                  <TextBox Text="{Binding RegenerateNote, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="10,7"
                           views:FocusWhenShown.IsEnabled="True" AutomationProperties.Name="Why write it again (optional)">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding RegenerateSegmentCommand}" />
                      <KeyBinding Key="Escape" Command="{Binding CancelNoteCommand}" />
                    </TextBox.InputBindings>
                  </TextBox>
                  <UniformGrid Columns="2" Margin="0,8,0,0">
                    <Button Content="Write it again" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Command="{Binding RegenerateSegmentCommand}" />
                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="4,0,0,0" Command="{Binding CancelNoteCommand}"
                            AutomationProperties.Name="Cancel the note" />
                  </UniformGrid>
                </StackPanel>
              </Border>
              <Button Content="Edit text…" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="0,8,0,0" Command="{Binding StartEditCommand}"
                      Visibility="{Binding IsScriptPanel, Converter={StaticResource Visible}}" />
              <UniformGrid Columns="2" Margin="0,8,0,0" Visibility="{Binding IsBoardPanel, Converter={StaticResource Visible}}">
                <Button Content="Edit description…" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="0,0,4,0" Command="{Binding StartEditShotCommand}" />
                <Button Content="Merge with next" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="4,0,0,0" Command="{Binding MergeWithNextCommand}"
                        AutomationProperties.Name="Merge with the next shot" />
              </UniformGrid>
              <StackPanel Visibility="{Binding IsStillPanel, Converter={StaticResource Visible}}">
                <UniformGrid Columns="2" Margin="0,8,0,0">
                  <Button Content="Edit prompt…" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="0,0,4,0" Command="{Binding StartEditPromptCommand}" />
                  <Button Content="Replace with file…" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="4,0,0,0" Command="{Binding ReplaceStillCommand}" />
                </UniformGrid>
                <Button Content="Take out of the batch" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="0,8,0,0" Command="{Binding UnqueueStillCommand}"
                        Visibility="{Binding StillIsQueued, Converter={StaticResource Visible}}" />
              </StackPanel>
              <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="0,8,0,0" Command="{Binding CancelSegmentCommand}"
                      AutomationProperties.Name="Cancel the segment"
                      Visibility="{Binding SelectedIsRunning, Converter={StaticResource Visible}}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="SELECTED" Style="{StaticResource SectionLabelStyle}" />
                <TextBlock Text="{Binding SelectedHeading}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" />
                <TextBlock Text="{Binding SelectedStatus}" FontSize="13" Foreground="{StaticResource TextSoftBrush}" Margin="0,2,0,10" />
                <TextBlock Text="{Binding SelectedNote}" FontSize="12" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" Margin="0,-6,0,10"
                           Visibility="{Binding SelectedNote, Converter={views:NullToCollapsedConverter}}" />
                <TextBlock Text="{Binding SelectedError}" FontSize="13" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Visibility="{Binding SelectedError, Converter={views:NullToCollapsedConverter}}" />
                <!-- Out of date: why, and how it comes up to date. -->
                <Border Background="{StaticResource NoteBackBrush}" BorderBrush="#3D3663" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding SelectedStale, Converter={views:NullToCollapsedConverter}}">
                  <StackPanel>
                    <TextBlock Text="{Binding SelectedStale}" FontSize="13" Foreground="#D4CCFA" TextWrapping="Wrap" AutomationProperties.AutomationId="SelectedStale" />
                    <TextBlock Text="{Binding SelectedStaleHint}" FontSize="12" Foreground="#B4A8F5" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="It still shows what it was." FontSize="12" Foreground="#B4A8F5" TextWrapping="Wrap" Margin="0,2,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                        Visibility="{Binding SelectedShowsLog, Converter={StaticResource Visible}}">
                  <ItemsControl ItemsSource="{Binding SelectedActivity}" ItemTemplate="{StaticResource ActivityLineTemplate}"
                                FontFamily="{StaticResource MonoFont}" FontSize="12" Focusable="False" AutomationProperties.Name="Segment activity" />
                </Border>

                <!-- A Still cell: the picture first, as board 2b draws it. -->
                <StackPanel Visibility="{Binding IsStillPanel, Converter={StaticResource Visible}}">
                  <Border CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12"
                          Visibility="{Binding StillPicture, Converter={views:NullToCollapsedConverter}}">
                    <Image Source="{Binding StillPicture, Converter={views:ThumbnailConverter}, ConverterParameter=720}" Stretch="Uniform" MaxHeight="240"
                           AutomationProperties.Name="The still" />
                  </Border>
                  <TextBlock Text="The picture is gone from the projects folder. Regenerate makes it again." FontSize="13" Foreground="{StaticResource ErrorTextBrush}"
                             TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding StillIsMissing, Converter={StaticResource Visible}}" />
                  <TextBlock Text="{Binding StillQueuedText}" FontSize="13" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                             Visibility="{Binding StillIsQueued, Converter={StaticResource Visible}}" AutomationProperties.AutomationId="StillQueued" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding SelectedVersions}" Focusable="False" Margin="0,0,0,12" AutomationProperties.Name="Versions">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type script:SegmentVersionChoice}">
                      <Button Content="{Binding Label}" Margin="0,0,6,6" FontFamily="{StaticResource MonoFont}" ToolTip="{Binding Note}"
                              Command="{Binding DataContext.ShowVersionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              CommandParameter="{Binding Version}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsShown}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- A Voice cell: play it, and watch the word being heard. -->
                <StackPanel DataContext="{Binding Playback}" Visibility="{Binding DataContext.IsVoicePanel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}">
                  <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Left" Content="{Binding PlayLabel}" Style="{StaticResource PrimaryButtonStyle}" MinHeight="36" MinWidth="88" FontSize="13"
                            Command="{Binding PlayPauseCommand}" AutomationProperties.Name="Play or pause the voice" />
                    <TextBlock Text="{Binding PositionText}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource TextSoftBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0" AutomationProperties.AutomationId="VoicePosition" />
                  </DockPanel>
                  <TextBlock Text="The audio file is gone from the projects folder. Regenerate speaks it again." FontSize="13" Foreground="{StaticResource ErrorTextBrush}"
                             TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding IsMissing, Converter={StaticResource Visible}}" />
                  <TextBlock Text="{Binding Error}" FontSize="13" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                             Visibility="{Binding Error, Converter={views:NullToCollapsedConverter}}" />
                  <TextBlock Text="Words" Style="{StaticResource FieldLabelStyle}" />
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <ItemsControl ItemsSource="{Binding Words}" Focusable="False" AutomationProperties.Name="Spoken words">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type script:SpokenWordViewModel}">
                          <Button Command="{Binding SeekCommand}" Cursor="Hand" ToolTip="{Binding StartText}" Margin="0,0,1,3"
                                  AutomationProperties.Name="{Binding Text}" FocusVisualStyle="{StaticResource RoundedFocusVisual}">
                            <Button.Template>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="Back" CornerRadius="4" Padding="3,1" Background="Transparent">
                                  <TextBlock x:Name="Word" Text="{Binding Text}" FontSize="14" Foreground="{StaticResource TextBrush}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                  <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter TargetName="Word" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                  </DataTrigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Button.Template>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                             Text="When each word is heard is estimated from the text. Click a word to hear from there." />
                </StackPanel>

                <!-- A Still cell: its prompt and how it was made. -->
                <StackPanel Visibility="{Binding IsStillPanel, Converter={StaticResource Visible}}">
                  <TextBlock Text="{Binding StillPromptTitle}" Style="{StaticResource FieldLabelStyle}" />
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10"
                          Visibility="{Binding IsNotEditingAny, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding StillPrompt}" FontSize="13" TextWrapping="Wrap" LineHeight="20" AutomationProperties.AutomationId="StillPrompt" />
                  </Border>
                  <StackPanel Visibility="{Binding IsEditingPrompt, Converter={StaticResource Visible}}">
                    <TextBox Text="{Binding EditPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                             VerticalContentAlignment="Top" FontSize="13" Padding="10,8" views:FocusWhenShown.IsEnabled="True" AutomationProperties.Name="Your prompt" />
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,8"
                               Text="Used as it is, not through the profile's template. The still waits in the batch: Continue pipeline makes it." />
                    <UniformGrid Columns="2">
                      <Button Content="Use this prompt" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Command="{Binding QueuePromptCommand}"
                              AutomationProperties.Name="Use this prompt: it waits in the batch" />
                      <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="4,0,0,0" Command="{Binding CancelEditPromptCommand}"
                              AutomationProperties.Name="Cancel the prompt" />
                    </UniformGrid>
                  </StackPanel>
                  <TextBlock Text="{Binding StillDetails}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap"
                             Margin="0,10,0,0" AutomationProperties.AutomationId="StillDetails" />
                  <TextBlock Text="{Binding StillMadeFrom}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Visibility="{Binding StillMadeFrom, Converter={views:NullToCollapsedConverter}}" />
                </StackPanel>

                <!-- A Board cell: what board 8 drew, as the panel. -->
                <StackPanel Visibility="{Binding IsBoardPanel, Converter={StaticResource Visible}}">
                  <TextBlock Text="Shows" Style="{StaticResource FieldLabelStyle}" />
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10"
                          Visibility="{Binding IsNotEditingShot, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding BoardShows}" FontSize="14" TextWrapping="Wrap" LineHeight="21" AutomationProperties.AutomationId="BoardShows" />
                  </Border>
                  <StackPanel Visibility="{Binding IsEditingShot, Converter={StaticResource Visible}}">
                    <TextBox Text="{Binding EditShotDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                             VerticalContentAlignment="Top" FontSize="14" Padding="10,8" AutomationProperties.Name="Shot description" />
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                      <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Command="{Binding SaveShotDescriptionCommand}"
                              AutomationProperties.Name="Save the description" />
                      <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="4,0,0,0" Command="{Binding CancelEditShotCommand}"
                              AutomationProperties.Name="Cancel the description" />
                    </UniformGrid>
                  </StackPanel>

                  <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6">
                    <Run Text="Covers" /> <Run Text="(the narration of" /> <Run Text="{Binding Selected.Id, Mode=OneWay}" /><Run Text="; this shot lit)" />
                  </TextBlock>
                  <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <ItemsControl ItemsSource="{Binding BoardWords}" Focusable="False" AutomationProperties.Name="Words of the segment">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type script:BoardWord}">
                          <Button Command="{Binding DataContext.SplitAtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Index}"
                                  Margin="0,0,1,3" AutomationProperties.Name="{Binding Text, StringFormat='Split here, at {0}'}" FocusVisualStyle="{StaticResource RoundedFocusVisual}">
                            <Button.Template>
                              <ControlTemplate TargetType="Button">
                                <Border x:Name="Back" CornerRadius="4" Padding="3,1" Background="Transparent">
                                  <TextBlock x:Name="Word" Text="{Binding Text}" FontSize="14" Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                  <DataTrigger Binding="{Binding IsInShot}" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                    <Setter TargetName="Word" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                  </DataTrigger>
                                  <DataTrigger Binding="{Binding CanSplit}" Value="True">
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="ToolTip" Value="Split the shot here" />
                                  </DataTrigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Button.Template>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>

                  <DockPanel Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="later ▶" Style="{StaticResource SmallButtonStyle}" Margin="6,0,0,0" Command="{Binding StartLaterCommand}"
                            AutomationProperties.Name="Start one word later" />
                    <Button DockPanel.Dock="Right" Content="◀ earlier" Style="{StaticResource SmallButtonStyle}" Command="{Binding StartEarlierCommand}"
                            AutomationProperties.Name="Start one word earlier" />
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}">
                      <Run Text="Starts at “" /><Run Text="{Binding BoardStartWord, Mode=OneWay}" /><Run Text="”" />
                    </TextBlock>
                  </DockPanel>
                  <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Content="later ▶" Style="{StaticResource SmallButtonStyle}" Margin="6,0,0,0" Command="{Binding EndLaterCommand}"
                            AutomationProperties.Name="End one word later" />
                    <Button DockPanel.Dock="Right" Content="◀ earlier" Style="{StaticResource SmallButtonStyle}" Command="{Binding EndEarlierCommand}"
                            AutomationProperties.Name="End one word earlier" />
                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSoftBrush}">
                      <Run Text="Ends after “" /><Run Text="{Binding BoardEndWord, Mode=OneWay}" /><Run Text="”" />
                    </TextBlock>
                  </DockPanel>
                  <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                             Text="Cuts fall between words. Moving one changes the shot next to it, so the segment still adds up to its audio. Click a word in the shot to split it there." />

                  <TextBlock Text="Who and where (up to 4: what Minimax takes per clip)" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                  <ItemsControl ItemsSource="{Binding BoardCast}" Focusable="False" AutomationProperties.Name="Who and what is in the shot">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding}" ContentStringFormat="{}{0}  ×" Style="{StaticResource SmallButtonStyle}" Margin="0,0,6,6"
                                Command="{Binding DataContext.RemoveCastCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding StringFormat='Take {0} out of the shot'}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding BoardCastChoices}" Focusable="False" AutomationProperties.Name="Who and what can be added">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Content="{Binding}" ContentStringFormat="+ {0}" Style="{StaticResource SmallButtonStyle}" Margin="0,0,6,6" Foreground="{StaticResource TextMutedBrush}"
                                Command="{Binding DataContext.AddCastCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                AutomationProperties.Name="{Binding StringFormat='Put {0} in the shot'}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <CheckBox IsChecked="{Binding BoardContinues}" IsEnabled="{Binding CanEditBoard}" Margin="0,10,0,0" Foreground="{StaticResource TextBrush}" FontSize="13"
                            AutomationProperties.Name="Continues the shot before">
                    <TextBlock Text="Continues the shot before (same scene, the camera moves on)" TextWrapping="Wrap" />
                  </CheckBox>
                </StackPanel>

                <StackPanel Visibility="{Binding IsScriptPanel, Converter={StaticResource Visible}}">
                  <StackPanel Visibility="{Binding IsNotEditing, Converter={StaticResource Visible}}">
                    <TextBlock Text="Narration" Style="{StaticResource FieldLabelStyle}" />
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                      <TextBlock Text="{Binding SelectedNarration}" FontSize="14" TextWrapping="Wrap" LineHeight="21" AutomationProperties.AutomationId="Narration" />
                    </Border>
                  </StackPanel>

                  <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource Visible}}">
                    <TextBlock Text="Title" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="10,6" Margin="0,0,0,10" AutomationProperties.Name="Segment title" />
                    <TextBlock Text="Narration" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding EditNarration, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160"
                             VerticalContentAlignment="Top" FontSize="14" Padding="10,8" AutomationProperties.Name="Segment narration" />
                    <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,12"
                               Text="Saving makes a new version; the facts the segment lists stay as they are." />
                    <UniformGrid Columns="2">
                      <Button Content="Save" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Command="{Binding SaveEditCommand}" />
                      <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" MinHeight="44" Margin="4,0,0,0" Command="{Binding CancelEditCommand}" />
                    </UniformGrid>
                  </StackPanel>

                  <TextBlock Text="Facts used" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,6" />
                  <ItemsControl ItemsSource="{Binding SelectedFacts}" Focusable="False" AutomationProperties.Name="Facts used">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type script:UsedFact}">
                        <DockPanel Margin="0,0,0,6">
                          <TextBlock DockPanel.Dock="Left" Width="40" Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextSoftBrush}" />
                          <TextBlock DockPanel.Dock="Left" Width="26" Text="{Binding Weight}" FontFamily="{StaticResource MonoFont}" FontSize="12">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsMust}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                          <TextBlock Text="{Binding Statement}" FontSize="12" Foreground="{StaticResource TextSoftBrush}" TextWrapping="Wrap" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
