<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- WindowsCredentialStore uses [LibraryImport], whose generated marshalling needs unsafe
         (SYSLIB1062). No hand-written unsafe code exists. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoryForge.Client\StoryForge.Client.csproj" />
    <ProjectReference Include="..\StoryForge.Sources\StoryForge.Sources.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StoryForge.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Send to Resolve (#71) runs it in Resolve's own Python, so it has to sit beside the app as a file. -->
    <None Update="Resolve\send_to_resolve.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
