<Window x:Class="StoryForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StoryForge.App.ViewModels"
        xmlns:pages="clr-namespace:StoryForge.App.ViewModels.Pages"
        xmlns:views="clr-namespace:StoryForge.App.Views"
        xmlns:client="clr-namespace:StoryForge.Client;assembly=StoryForge.Client"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="StoryForge X"
        Icon="/Assets/StoryForge.ico"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource SansFont}"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <!-- A screen no issue has built yet: title plus one line. -->
    <DataTemplate DataType="{x:Type pages:PageViewModel}">
      <StackPanel Margin="32,28">
        <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" />
        <TextBlock Text="{Binding Placeholder}" Margin="0,8,0,0" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:SettingsPageViewModel}">
      <views:SettingsView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:ProfilesPageViewModel}">
      <views:ProfilesView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:NewProjectPageViewModel}">
      <views:NewProjectView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:ResultMatrixPageViewModel}">
      <views:ResultMatrixView />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Top bar: app name, breadcrumb, provider status pills. -->
    <Border Grid.Row="0" Background="{StaticResource TopBarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Viewbox Width="22" Height="22">
            <Canvas Width="24" Height="24">
              <Path Data="M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2zM3 9h18M8 5v4M16 5v4M10 12l4 2.5-4 2.5z"
                    Stroke="{StaticResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="StoryForge X" Margin="10,0,0,0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Breadcrumb}" Margin="16,0,0,0" FontSize="13" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                     AutomationProperties.Name="Breadcrumb" />
        </StackPanel>
        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding ProviderPills}" ItemTemplate="{StaticResource ProviderPillTemplate}"
                      VerticalAlignment="Center" Focusable="False" AutomationProperties.Name="Provider status">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left navigation and the recent projects list. -->
      <Border Grid.Column="0" Background="{StaticResource NavBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="14,20">
        <DockPanel>
          <ListBox DockPanel.Dock="Top" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNavItem}"
                   SelectionChanged="Navigation_SelectionChanged"
                   ItemContainerStyle="{StaticResource NavItemStyle}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   AutomationProperties.Name="Navigation">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                <StackPanel Orientation="Horizontal">
                  <ContentPresenter Content="{Binding IconData}" ContentTemplate="{StaticResource StrokeIconTemplate}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock DockPanel.Dock="Top" Text="RECENT PROJECTS" Style="{StaticResource SectionLabelStyle}" Margin="12,24,0,6" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding RecentProjectsError}" Margin="12,4,0,0" FontSize="12" TextWrapping="Wrap"
                     Foreground="{StaticResource ErrorTextBrush}" Visibility="{Binding RecentProjectsError, Converter={views:NullToCollapsedConverter}}" />
          <TextBlock DockPanel.Dock="Top" Text="No projects yet" Margin="12,4,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasRecentProjects}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding RecentProjectsError, Converter={views:NullToCollapsedConverter}}" Value="Visible">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <!-- Fills the rest of the column and scrolls, however many projects there are. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <ItemsControl ItemsSource="{Binding RecentProjects}" Focusable="False" AutomationProperties.Name="Recent projects">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type client:ProjectSummary}">
                  <Button Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" Cursor="Hand" HorizontalContentAlignment="Stretch"
                          AutomationProperties.Name="{Binding Name, StringFormat='Open {0}'}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Padding="12,6">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavHoverBrush}" />
                          </Trigger>
                          <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavHoverBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextSoftBrush}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding StatusLine}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- The selected screen. -->
      <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
  </Grid>
</Window>
